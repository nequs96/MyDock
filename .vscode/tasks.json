{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MyDock: Build canonical app",
      "type": "process",
      "command": "${workspaceFolder}/BuildMyDock.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "MyDock: Open canonical app",
      "type": "process",
      "command": "/usr/bin/open",
      "args": ["${workspaceFolder}/build/MyDock.app"],
      "problemMatcher": []
    },
    {
      "label": "MyDock: Build and open",
      "dependsOn": ["MyDock: Build canonical app", "MyDock: Open canonical app"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "MyDock: Test",
      "type": "process",
      "command": "${workspaceFolder}/TestMyDock.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
